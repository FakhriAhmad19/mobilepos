# =========================================================
# Kasirku Mobile — PRODUCTION environment (docker-compose.prod.yml).
# Copy to .env and fill in REAL secrets. Never commit the filled-in .env.
#
#   cp .env.prod.example .env
#   # then generate secrets:
#   #   APP_KEY:    openssl rand -hex 16         (must be 32 chars)
#   #   JWT_SECRET: openssl rand -base64 48
# =========================================================

# ---- MySQL (internal only; no port is published in prod) ----
MYSQL_ROOT_PASSWORD=CHANGE_ME_strong_root_password
MYSQL_DATABASE=kasirku
MYSQL_USER=kasirku
MYSQL_PASSWORD=CHANGE_ME_strong_app_password

# ---- Backend (Goravel) ----
APP_NAME=KasirkuMobile
# APP_ENV/APP_DEBUG are pinned to production/false by docker-compose.prod.yml.
APP_URL=https://your-domain.example
APP_KEY=CHANGE_ME_32_character_random_key
JWT_SECRET=CHANGE_ME_long_random_jwt_secret

# DB_* for the backend are derived from the MYSQL_* values above by
# docker-compose.prod.yml (host is the internal `mysql` service).
