# Kasirku Mobile app — Expo public env (must be prefixed EXPO_PUBLIC_)
# Copy to .env. On a physical device, replace localhost with your machine's LAN IP.
#
#   - Direct to Goravel:   http://localhost:3000/api/v1
#   - Through nginx proxy:  http://localhost:8080/api/v1
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
