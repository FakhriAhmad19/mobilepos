# syntax=docker/dockerfile:1
# ---------------------------------------------------------------------------
# Kasirku backend — production image (PRD Phase 9).
#
# Differs from the dev Dockerfile: deterministic dependency download (no
# `go mod tidy` at build), a non-root runtime user, a HEALTHCHECK, and NO baked
# secrets — real configuration is injected at runtime via environment variables
# (docker-compose `environment:` / `--env-file`). A placeholder .env is shipped
# only so the framework finds a file; env vars set by the runtime take
# precedence over it.
# ---------------------------------------------------------------------------
FROM golang:1.25-alpine AS builder

ENV GO111MODULE=on \
    CGO_ENABLED=0 \
    GOOS=linux

WORKDIR /build

# Download dependencies first so this layer caches across source-only changes.
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN go build -trimpath -ldflags "-s -w -extldflags -static" -o main .

# ---------------------------------------------------------------------------
FROM alpine:3.20

# ca-certificates for outbound TLS, tzdata for correct timestamps, wget for the
# healthcheck (busybox wget ships with alpine).
RUN apk add --no-cache ca-certificates tzdata \
    && addgroup -S app && adduser -S -G app app

WORKDIR /www

COPY --from=builder /build/main /www/main
COPY --from=builder /build/public/ /www/public/
COPY --from=builder /build/resources/ /www/resources/
# Placeholder env only — runtime environment variables override these values.
COPY --from=builder /build/.env.example /www/.env

# Writable dirs Goravel expects at runtime, owned by the unprivileged user.
RUN mkdir -p /www/storage/logs /www/storage/framework \
    && chown -R app:app /www

USER app

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD wget -qO- http://127.0.0.1:3000/api/v1/health || exit 1

ENTRYPOINT ["/www/main"]
