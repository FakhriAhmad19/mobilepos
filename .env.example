# =========================================================
# Kasirku Mobile — Root environment (used by docker-compose)
# Copy to .env and adjust before running `docker compose up`.
# =========================================================

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=root_secret_change_me
MYSQL_DATABASE=kasirku
MYSQL_USER=kasirku
MYSQL_PASSWORD=kasirku_secret_change_me
MYSQL_PORT=3306

# ---- Backend (Goravel) ----
APP_NAME=KasirkuMobile
APP_ENV=local
APP_DEBUG=true
APP_KEY=            # generate with: docker compose run --rm backend ./main artisan key:generate
APP_HOST=0.0.0.0
APP_PORT=3000
APP_URL=http://localhost:3000
JWT_SECRET=         # generate with: docker compose run --rm backend ./main artisan jwt:secret

# DB connection the backend uses (points at the `mysql` compose service)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=kasirku
DB_USERNAME=kasirku
DB_PASSWORD=kasirku_secret_change_me

# ---- Nginx ----
NGINX_PORT=8080
